# ─────────────────────────────────────────────────────────────
#  AJ Courier Logistics — Backend (Express API) environment
#  Copy to `.env` for local dev. On Render, set these in the
#  service's Environment tab. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Port — Render provides this automatically; leave unset in prod.
PORT=4000

# The deployed frontend origin (shared hosting domain). Used for CORS
# and to build the Paystack callback URL. No trailing slash.
FRONTEND_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────
# MongoDB Atlas SRV string. Include the DB name before the "?".
# Allow-list 0.0.0.0/0 under Atlas → Network Access (Render has dynamic IPs).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ajcl?retryWrites=true&w=majority
MONGODB_URI=

# ── Authentication ──────────────────────────────────────────
# Long random string used to sign session JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
# Session lifetime (e.g. 7d, 12h).
SESSION_MAX_AGE=7d

# Bootstrap admin account, created on first DB connect if it does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=AJC Admin

# ── Google Maps Platform (optional, server cross-check only) ─
# Unrestricted or IP-restricted key with "Places API (New)" + "Routes API".
# The browser does the real map work; this is only a server-side verification.
GOOGLE_MAPS_API_KEY=

# ── Paystack ────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# ── Email (Resend transactional email) ──────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend
# (e.g. no-reply@ajcourierlogistics.com). Use "AJ Courier & Logistics
# <onboarding@resend.dev>" for testing before your domain is verified.
EMAIL_FROM=AJ Courier & Logistics <onboarding@resend.dev>
# Where customer replies go (defaults to ADMIN_EMAIL, then info@ajcourierlogistics.com).
SUPPORT_EMAIL=
